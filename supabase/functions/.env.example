# Server-only Instagram Login token (eligible Business/Creator account).
# Copy to supabase/functions/.env for local Edge Functions.
# For the hosted store, add this key in shoe > Edge Functions > Secrets.
INSTAGRAM_ACCESS_TOKEN=replace_with_your_own_instagram_login_token
# Optional. A valid token enables the feed automatically. Set false to hide it.
INSTAGRAM_FEED_ENABLED=true
